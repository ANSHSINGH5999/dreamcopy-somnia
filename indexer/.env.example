# RPC + DreamDEX endpoints — see dreamcopy/docs/ARCHITECTURE.md for the
# verified values (defaults below match it).
RPC_URL=https://dream-rpc.somnia.network
DREAMDEX_WS_URL=wss://stg.api.dreamdex.io/v0/ws/public
DREAMDEX_REST_BASE=https://stg.api.dreamdex.io/v0

# Already-deployed contract addresses (same values as dreamcopy/web/.env.local).
TRADER_REGISTRY_ADDRESS=0x9588F907bC87D4a6Adb1Ab25dAC5E872ED8428aa
COPY_VAULT_ADDRESS=0xbAe48232cAFA1B3F6921e466ba4f29E65D11ACbF

# NOT read from here: the executor's signing key is read directly from
# dreamcopy/contracts/.env (PRIVATE_KEY) — see src/config.ts. Do not
# duplicate a private key in this file.

# Telegram notifications — optional. The indexer runs fine with these unset,
# it just skips sending (and logs why).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often (ms) to re-poll TraderRegistry for the active trader list.
TRADER_REFRESH_MS=30000

# Set to 1 to log every raw WS message as it arrives. Use this the first
# time you get a real connection to capture an actual payload and fix
# parseTradeEvent in src/detector.ts — its field-name guesses are UNVERIFIED
# (see that file's header comment for why).
LOG_RAW_MESSAGES=0

# Optional JSON string sent immediately after the WS connection opens, in
# case the real feed needs an explicit subscribe handshake (unconfirmed —
# see src/detector.ts). Leave unset to send nothing on connect.
WS_SUBSCRIBE_MESSAGE=

# Proportional-sizing dust floor, in RAW collateral-token units (see
# src/executor.ts). Below this, a scaled-down trade is skipped and logged
# instead of sent on-chain. Tune to your collateral token's decimals.
DUST_THRESHOLD=1000
REFERRAL_REGISTRY_ADDRESS=0x649fcD52C8011088c47dD724Dd400D81a90B6fC0
